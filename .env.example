# Add your own Twelve Data API key here on the server.
# Never put this key in index.html or share it publicly.
TWELVE_DATA_API_KEY=PASTE_YOUR_KEY_HERE
PORT=8080

# Firebase Cloud Messaging setup (Firebase console > Project settings > General + Cloud Messaging)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FCM_VAPID_KEY=
# Firebase Admin service-account JSON (one-line JSON). Keep private.
FIREBASE_SERVICE_ACCOUNT_JSON=
